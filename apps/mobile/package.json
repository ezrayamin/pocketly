{
  "name": "@pocketly/mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start --port 8081",
    "test": "jest",
    "start:kmp": "react-native start --port 8082",
    "android:js": "react-native run-android --mode jsCoreDebug --appIdSuffix js --port 8081",
    "android:kmp": "react-native run-android --mode kmpCoreDebug --appIdSuffix kmp --port 8082",
    "android:release:js": "cd android && ./gradlew assembleJsCoreRelease",
    "android:release:kmp": "cd android && ./gradlew assembleKmpCoreRelease",
    "pods:js": "cd ios && bundle exec pod install",
    "pods:kmp": "yarn --cwd ../.. workspace @pocketly/core-kmp build:ios-framework && cd ios && CORE_IMPL=kmp bundle exec pod install",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pocketly/core-contract": "0.1.0",
    "@pocketly/core-js": "0.1.0",
    "@pocketly/core-kmp": "0.1.0",
    "@react-native/new-app-screen": "0.87.1",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-nitro-modules": "0.37.1",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
